// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EMPLOYEE
  MANAGER
}

enum Module {
  CARNES_PREPARADAS
  CARNES_AHUMADAS
  CARNE_CRUDA
  VERDURAS
  BEBIDAS_BODEGA
  BEBIDAS_SERVICIO
  SALSAS
  COCINA
  SERVICIO
  BODEGA
  DESECHABLES
  GUARNICIONES
  FRITURAS_RESTAURANTE
  VERDURAS_RESTAURANTE
  HARINAS_ACEITE_RESTAURANTE
  HARINAS_ACEITE_BODEGA
  PAN
  PAN_RESTAURANTE
  FRITURAS
  LACTEOS_RESTAURANTE
  LACTEOS_BODEGA
  CONDIMENTOS_RESTAURANTE
  DESECHABLES_BOLSAS_RESTAURANTE
  DESECHABLES_BODEGA
  SALSAS_ADEREZOS_RESTAURANTE
  LIMPIEZA_RESTAURANTE
  SALSAS_ADEREZOS_BODEGA
  CONDIMENTOS_BODEGA
  MATERIA_PRIMA_SALSA
  LIMPIEZA_BODEGA
}

enum StockStatus {
  OK
  BAJO
  CRITICO
}

model User {
  id        String        @id @default(cuid())
  name      String
  pin       String
  role      Role          @default(EMPLOYEE)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  records   DailyRecord[]
}

model Product {
  id        String        @id @default(cuid())
  name      String
  category  String
  module    Module
  sharedId  String?
  unit      String        @default("unidad")
  minStock  Float         @default(0)
  maxStock  Float?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  records   DailyRecord[]
  purchases Purchase[]
}

// Lo que el equipo del restaurante escribe que le hace falta; el gerente o el dueño lo marca como llevado.
// Es texto libre: no depende del catálogo de productos.
model Pedido {
  id              String    @id @default(cuid())
  text            String
  status          String    @default("PENDIENTE") // PENDIENTE | LLEVADO | CANCELADO
  requestedById   String?
  requestedByName String
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedByName  String?

  @@index([status, createdAt])
}

model Purchase {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  unit      String
  unitCost  Float?
  supplier  String?
  notes     String?
  userId    String?
  kind      String   @default("COMPRA")
  shift     String?
  batchId   String?
  warehouseDeducted Float?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model DailyRecord {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  date          DateTime    @db.Date

  // Stock simple (cocina, bodega, servicio, salsas)
  currentStock  Float?

  // Seguimiento de peso (carnes preparadas, carne cruda, verduras)
  initialWeight Float?
  restock       Float?
  restockMorning Float?

  // Cierre de carnes: lo que regresa a Bodega y lo que se bota (merma). No cuentan como consumo.
  returnedQty   Float?
  wasteQty      Float?
  wasteReason   String?
  waste1        Float?
  waste2        Float?
  finalWeight   Float?

  // Carnes ahumadas
  units         Int?
  weightLb      Float?

  // Bebidas servicio
  initialStock  Float?
  midStock      Float?
  finalStock    Float?
  consumption   Float?

  status        StockStatus @default(OK)
  notes         String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([productId, date])
}

model Alert {
  id          String      @id @default(cuid())
  productId   String
  productName String
  module      Module
  status      StockStatus
  message     String
  read        Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

model DayClose {
  id           String   @id @default(cuid())
  date         DateTime @unique @db.Date
  closedAt     DateTime @default(now())
  closedByName String
}

model DayConsumptionSnapshot {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  productId        String
  productName      String
  module           Module
  unit             String
  consumption      Float
  consumoMedioDia  Float?
  consumoNoche     Float?
  initial          Float?
  mid              Float?
  restock          Float?
  final            Float?
  returned         Float?
  waste            Float?
  createdAt        DateTime @default(now())

  @@unique([productId, date])
}
